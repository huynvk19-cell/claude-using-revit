<Project Sdk="Microsoft.NET.Sdk">
  <!--
    claude using revit: the Revit add-in of this repo. One DLL per Revit version:
      dotnet build -c Release -p:RevitVersion=2024   (net48, Revit 2023-2024)
      dotnet build -c Release -p:RevitVersion=2025   (net8.0-windows, Revit 2025-2026)
      dotnet build -c Release -p:RevitVersion=2027   (net10.0-windows, Revit 2027)
    addin/build.ps1 builds every version and lays out dist/<version>/ (add-in + roslyn/ + Lib/).
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <TargetFramework Condition="$(RevitVersion) &lt; 2025">net48</TargetFramework>
    <TargetFramework Condition="$(RevitVersion) &gt;= 2025 And $(RevitVersion) &lt; 2027">net8.0-windows</TargetFramework>
    <TargetFramework Condition="$(RevitVersion) &gt;= 2027">net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ClaudeUsingRevit</AssemblyName>
    <RootNamespace>ClaudeUsingRevit</RootNamespace>
    <Version>0.1.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <OutputPath>bin\$(Configuration)\$(RevitVersion)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416;NU1701;MSB3270;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Revit API: reference only, Revit supplies the real ones -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- the Python of the ribbon tools and shared tasks (addin/extension) -->
    <PackageReference Include="IronPython" Version="2.7.12" />
    <PackageReference Include="IronPython.StdLib" Version="2.7.12" />
  </ItemGroup>

  <!-- the exact reference set of this build, for addin/tests/CommandCheck (compiles revit-commands/*.cs offline) -->
  <Target Name="CurWriteCompileRefs" AfterTargets="ResolveAssemblyReferences">
    <MakeDir Directories="$(OutDir)" />
    <WriteLinesToFile File="$(OutDir)compile-refs.txt" Lines="@(ReferencePath)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
</Project>
