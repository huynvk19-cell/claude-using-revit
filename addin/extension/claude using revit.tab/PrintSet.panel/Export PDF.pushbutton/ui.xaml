<!-- Liquid Glass: styles come from lib/liquid_glass.xaml (loaded by liquid_glass.GlassWindow) -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xuất PDF / CAD" Width="516" SizeToContent="Height"
        WindowStyle="None" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="{StaticResource Ui}" FontSize="13" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display">
  <ContentControl x:Name="glass" Style="{StaticResource GlassPanel}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid x:Name="header" Grid.Row="0" Margin="24,22,18,0" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ContentControl x:Name="icon" Style="{StaticResource AppIcon}"/>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Xuất PDF / CAD" Style="{StaticResource Title}"/>
          <TextBlock x:Name="subtitle" Style="{StaticResource Subtitle}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button x:Name="close_btn" Grid.Column="2" Style="{StaticResource CloseBtn}" VerticalAlignment="Top"
                ToolTip="Đóng (Esc)"/>
      </Grid>

      <!-- the middle scrolls when the screen is too low; the Xuất button is outside it, always there -->
      <ScrollViewer x:Name="body" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,4,0,0" Padding="0,0,24,0">
      <StackPanel>
        <Grid Margin="0,18,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid>
            <TextBox x:Name="search" Height="34" Padding="12,0" VerticalContentAlignment="Center"/>
            <TextBlock x:Name="search_hint" Text="Lọc theo số hoặc tên sheet" IsHitTestVisible="False"
                       Foreground="{StaticResource Ink3}" Margin="15,0,0,0" VerticalAlignment="Center"/>
          </Grid>
          <ToggleButton x:Name="pick_all" Grid.Column="1" Style="{StaticResource Chip}" Margin="8,0,0,0"
                        Content="Chọn hết" ToolTip="Chọn / bỏ chọn mọi sheet đang hiện trong danh sách"/>
        </Grid>
        <Border Style="{StaticResource Well}">
          <ScrollViewer x:Name="scroller" MaxHeight="420" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="sheet_list"/>
          </ScrollViewer>
        </Border>
        <TextBlock Text="Kéo lướt qua các sheet để chọn / bỏ chọn nhiều · Shift+click: cả một dải · Ctrl+A: chọn hết"
                   Foreground="{StaticResource Ink3}" FontSize="11.5" Margin="6,8,0,0" TextWrapping="Wrap"/>
        <Border x:Name="warn_box" Style="{StaticResource WarnNote}" Visibility="Collapsed">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="warn_text" Foreground="#8A5A00" FontSize="12" TextWrapping="Wrap"
                       VerticalAlignment="Center"/>
            <Button x:Name="retry_btn" Grid.Column="1" Style="{StaticResource Ghost}" Margin="8,0,0,0"
                    Foreground="#8A5A00" Content="Thử lại"
                    ToolTip="Xoá trí nhớ văng của model này: lần xuất này vẽ lại các view / sheet đó"/>
          </Grid>
        </Border>

        <TextBlock Text="XUẤT RA" Style="{StaticResource Caption}" Margin="6,18,0,8"/>
        <StackPanel Orientation="Horizontal">
          <ToggleButton x:Name="fmt_pdf" Style="{StaticResource Chip}" Content="PDF"
                        ToolTip="Mỗi sheet một file PDF vector"/>
          <ToggleButton x:Name="fmt_dwg" Style="{StaticResource Chip}" Margin="8,0,0,0" Content="CAD (DWG)"
                        ToolTip="Mỗi sheet một file DWG: xuất từng view rồi ghép bằng AutoCAD để Revit không văng"/>
        </StackPanel>
        <StackPanel x:Name="dwg_box" Visibility="Collapsed">
          <TextBlock Text="TEMPLATE XUẤT CAD" Style="{StaticResource Caption}" Margin="6,14,0,8"/>
          <ComboBox x:Name="setup_box" Height="34" VerticalContentAlignment="Center"
                    ToolTip="DWG export setup của model; mặc định là template dùng lần trước, chưa có thì template đang chọn trong Revit"/>
        </StackPanel>

        <TextBlock Text="CHIA THƯ MỤC CON THEO" Style="{StaticResource Caption}" Margin="6,18,0,8"/>
        <ComboBox x:Name="group_box" Height="34" VerticalContentAlignment="Center"
                  ToolTip="Mỗi sheet vẫn là một file riêng; tuỳ chọn này chỉ xếp các file vào thư mục con theo tham số của sheet"/>
        <TextBlock x:Name="group_preview" Foreground="{StaticResource Ink2}" FontSize="12" Margin="6,8,0,0"
                   TextWrapping="Wrap"/>

        <Border Style="{StaticResource Stat}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="big_count" Text="0" FontFamily="{StaticResource UiDisplay}" FontSize="34"
                       FontWeight="SemiBold" Foreground="#3B5BDB" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="summary" FontWeight="SemiBold" Text="sheet sẽ xuất"/>
              <TextBlock x:Name="folder_text" Foreground="{StaticResource Ink2}" FontSize="12" Margin="0,2,0,0"
                         TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Grid>
        </Border>

      </StackPanel>
      </ScrollViewer>

        <Grid Grid.Row="2" Margin="24,14,24,22">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="folder_btn" Style="{StaticResource Ghost}" ToolTip="Đổi thư mục lưu file">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center"/>
              <TextBlock Text="Thư mục" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="export_btn" Grid.Column="2" Style="{StaticResource Primary}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xEA90;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center"/>
              <TextBlock x:Name="export_text" Text="Xuất" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>
    </Grid>
  </ContentControl>
</Window>
