<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="claude using revit" Width="456" SizeToContent="Height"
        WindowStyle="None" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="{StaticResource Ui}" FontSize="13" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display">
  <ContentControl x:Name="glass" Style="{StaticResource GlassPanel}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid x:Name="header" Margin="24,20,24,0" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ContentControl x:Name="icon" Style="{StaticResource AppIcon}"/>
        <TextBlock x:Name="head_title" Grid.Column="1" Style="{StaticResource Title}" Margin="14,0,8,0"
                   VerticalAlignment="Center" TextWrapping="Wrap"/>
        <Button x:Name="close_btn" Grid.Column="2" Style="{StaticResource CloseBtn}" VerticalAlignment="Top"
                ToolTip="Đóng (Esc)"/>
      </Grid>
      <!-- the middle gives way on a low screen (screen_fit.py); the buttons are outside it, always there -->
      <ScrollViewer x:Name="body" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,0,0,20" Padding="0,0,24,0">
        <StackPanel>
          <TextBlock x:Name="message" Margin="4,16,4,0" TextWrapping="Wrap" LineHeight="20"/>
          <Border x:Name="rows_box" Margin="0,14,0,0" Visibility="Collapsed">
            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="rows"/>
            </ScrollViewer>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="buttons_bar" Grid.Row="2" Margin="24,0,24,22">
        <StackPanel x:Name="buttons" Orientation="Horizontal" HorizontalAlignment="Right"/>
      </Grid>
    </Grid>
  </ContentControl>
</Window>
