<Project Sdk="Microsoft.NET.Sdk">
  <!--
    ClaudeUsingRevit-Setup.exe (.NET Framework 4.8: present on every Windows 10 / 11, nothing to install first).
    Built by make-setup.sh, which first lays out the payload zip that this exe carries inside.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ClaudeUsingRevit-Setup</AssemblyName>
    <RootNamespace>ClaudeUsingRevit.Setup</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>0.1.0</Version>
    <Product>claude using revit</Product>
    <PayloadZip Condition="'$(PayloadZip)' == ''">$(MSBuildThisFileDirectory)..\dist\payload.zip</PayloadZip>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
  </ItemGroup>
</Project>
