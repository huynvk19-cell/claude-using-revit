<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compile every revit-commands/*.cs the way claude using revit does in Revit, without Revit (Windows, Linux, CI):
      dotnet build addin/src/ClaudeUsingRevit -c Release -p:RevitVersion=2025
      then run this project with the Revit version as argument (addin/build.ps1 -Check does both)
    Also checks the header rules of CLAUDE.md (description 1-2 lines, parameter descriptions <= 80 characters).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ClaudeUsingRevit.Compiler\ClaudeUsingRevit.Compiler.csproj" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
