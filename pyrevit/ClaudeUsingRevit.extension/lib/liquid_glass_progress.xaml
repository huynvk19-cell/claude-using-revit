<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="claude using revit" Width="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="Manual" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{StaticResource Ui}" FontSize="13" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display">
  <ContentControl x:Name="glass" Style="{StaticResource GlassPanel}">
    <Grid Margin="14,12,12,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <ContentControl x:Name="icon" Style="{StaticResource AppIcon}" Width="36" Height="36"/>
      <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
        <TextBlock x:Name="label" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <ProgressBar x:Name="bar" Style="{StaticResource Bar}" Margin="0,8,0,2" Maximum="1"/>
      </StackPanel>
      <Button x:Name="cancel_btn" Grid.Column="2" Style="{StaticResource Secondary}" VerticalAlignment="Center">
        <TextBlock x:Name="cancel_text" Text="Dừng"/>
      </Button>
    </Grid>
  </ContentControl>
</Window>
