<!-- Liquid Glass: styles come from lib/liquid_glass.xaml (loaded by liquid_glass.GlassWindow) -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print set" Width="540" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="{StaticResource Ui}" FontSize="13" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display">
  <ContentControl x:Name="glass" Style="{StaticResource GlassPanel}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid x:Name="header" Grid.Row="0" Margin="24,22,18,0" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ContentControl Style="{StaticResource AppIcon}" Content="&#xE749;"/>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Print set theo danh mục" Style="{StaticResource Title}"/>
          <TextBlock Text="Cùng tên schedule, đúng các sheet schedule đang hiện" Style="{StaticResource Subtitle}"/>
        </StackPanel>
        <Button x:Name="close_btn" Grid.Column="2" Style="{StaticResource CloseBtn}" VerticalAlignment="Top"
                ToolTip="Đóng (Esc)"/>
      </Grid>

      <StackPanel Grid.Row="1" Margin="24,4,24,22">
        <TextBlock Text="SCHEDULE DANH MỤC BẢN VẼ" Style="{StaticResource Caption}"/>
        <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="schedules_list"/>
        </ScrollViewer>

        <Border Style="{StaticResource Stat}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="big_count" Text="0" FontFamily="{StaticResource UiDisplay}" FontSize="34"
                       FontWeight="SemiBold" Foreground="#3B5BDB" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="summary" FontWeight="SemiBold" Text="sheet"/>
              <TextBlock x:Name="summary_sub" Foreground="{StaticResource Ink2}" FontSize="12" Margin="0,2,0,0"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Margin="0,18,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="list_caption" Text="THAY ĐỔI" Style="{StaticResource Caption}" Margin="6,0,0,0"
                     VerticalAlignment="Center"/>
          <ToggleButton x:Name="all_chip" Grid.Column="1" Style="{StaticResource Chip}"
                        Content="Cả danh sách" ToolTip="Hiện mọi sheet theo thứ tự của schedule"/>
        </Grid>
        <Border Style="{StaticResource Well}">
          <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="sheet_list"/>
          </ScrollViewer>
        </Border>

        <Border x:Name="warn_box" Style="{StaticResource WarnNote}" Visibility="Collapsed">
          <StackPanel>
            <TextBlock x:Name="warn_text" Foreground="#8A5A00" FontSize="12" TextWrapping="Wrap"/>
            <CheckBox x:Name="force_chk" Margin="0,8,0,0" Foreground="#8A5A00" FontSize="12"
                      Content="Vẫn ghi đè print set này"/>
          </StackPanel>
        </Border>
        <Border x:Name="done_box" Style="{StaticResource DoneNote}" Visibility="Collapsed">
          <TextBlock x:Name="done_text" Foreground="#16794C" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="open_btn" Style="{StaticResource Ghost}" ToolTip="Đóng cửa sổ và mở schedule đang chọn">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center"/>
              <TextBlock Text="Mở schedule" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="apply_btn" Grid.Column="2" Style="{StaticResource Primary}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE895;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
              <TextBlock x:Name="apply_text" Text="Cập nhật" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </Grid>
  </ContentControl>
</Window>
