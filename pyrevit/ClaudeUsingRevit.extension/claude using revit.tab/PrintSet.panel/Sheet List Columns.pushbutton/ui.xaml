<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chuẩn cột danh mục" Width="540" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Foreground="#1F2328"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#4F8DFD" Offset="0"/>
      <GradientStop Color="#3B5BDB" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#8A8F98"/>
      <Setter Property="Margin" Value="2,18,0,8"/>
    </Style>

    <Style x:Key="Pick" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="b" CornerRadius="10" Padding="12,9" Margin="0,0,0,6"
                    Background="#F7F7F9" BorderBrush="#EDEDF1" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="box" Width="18" Height="18" CornerRadius="5" Margin="0,0,12,0"
                        VerticalAlignment="Center" Background="White" BorderBrush="#C9CBD3" BorderThickness="1.5">
                  <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="11"
                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="Hidden"/>
                </Border>
                <ContentPresenter Grid.Column="1"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#A9C4FB"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#EFF4FF"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#4F7CF7"/>
                <Setter TargetName="box" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="#3B5BDB"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#6B7280"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="b" CornerRadius="12" Padding="10,3"
                    Background="#F5F5F7" BorderBrush="#E6E6EB" BorderThickness="1">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#A9C4FB"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#EFF4FF"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#4F7CF7"/>
                <Setter Property="Foreground" Value="#2F4FC4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="10" Padding="18,10" Background="{StaticResource Accent}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="#D9D9DE"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#4B5563"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="10" Padding="12,10" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#F1F1F4"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="18" CornerRadius="16" Background="White" BorderBrush="#E6E6EB" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.20"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid x:Name="header" Grid.Row="0" Margin="22,20,14,0" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource Accent}">
          <TextBlock Text="&#xE80A;" FontFamily="{StaticResource Icons}" FontSize="19"
                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Chuẩn cột danh mục" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock TextTrimming="CharacterEllipsis"
                     Text="No. · Sheet Number · Sheet Name · Revision · Revision Date"
                     Foreground="#8A8F98" Margin="0,2,0,0"/>
        </StackPanel>
        <Button x:Name="close_btn" Grid.Column="2" Style="{StaticResource Ghost}" VerticalAlignment="Top"
                ToolTip="Đóng (Esc)">
          <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="12"/>
        </Button>
      </Grid>

      <StackPanel Grid.Row="1" Margin="22,4,22,20">
        <Grid Margin="0,18,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="SCHEDULE DANH MỤC BẢN VẼ" Style="{StaticResource Caption}" Margin="2,0,0,0"
                     VerticalAlignment="Center"/>
          <ToggleButton x:Name="pick_all" Grid.Column="1" Style="{StaticResource Chip}"
                        Content="Chọn hết" ToolTip="Chọn / bỏ chọn mọi schedule"/>
        </Grid>
        <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="schedules_list"/>
        </ScrollViewer>

        <Border CornerRadius="12" Background="#FAFAFB" BorderBrush="#EFEFF3" BorderThickness="1"
                Padding="14,12" Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="big_count" Text="0" FontSize="28" FontWeight="SemiBold"
                       Foreground="#3B5BDB" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="summary" FontWeight="SemiBold" Text="sheet"/>
              <TextBlock x:Name="summary_sub" Foreground="#8A8F98" FontSize="12" Margin="0,2,0,0"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Margin="0,18,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="list_caption" Text="THAY ĐỔI" Style="{StaticResource Caption}" Margin="2,0,0,0"
                     VerticalAlignment="Center"/>
          <ToggleButton x:Name="all_chip" Grid.Column="1" Style="{StaticResource Chip}"
                        Content="Số No. từng sheet" ToolTip="Hiện số No. cũ → mới của các sheet được đánh lại"/>
        </Grid>
        <Border CornerRadius="10" BorderBrush="#EFEFF3" BorderThickness="1" Padding="10,6">
          <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="sheet_list"/>
          </ScrollViewer>
        </Border>

        <TextBlock Text="GÁN MỘT GIÁ TRỊ CHO MỌI SHEET" Style="{StaticResource Caption}"/>
        <Border CornerRadius="10" BorderBrush="#EFEFF3" BorderThickness="1" Padding="10,8">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="fill_param" Height="32" VerticalContentAlignment="Center"
                        ToolTip="Tham số của sheet (không có Sheet Number, Sheet Name, No.)"/>
              <Grid Grid.Column="2">
                <TextBox x:Name="fill_value" Height="32" Padding="6,0" VerticalContentAlignment="Center"
                         BorderBrush="#D9D9DE"/>
                <TextBlock x:Name="fill_hint" Text="Giá trị (để trống = xoá)" IsHitTestVisible="False"
                           Foreground="#B0B4BC" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </Grid>
              <Button x:Name="fill_btn" Grid.Column="3" Style="{StaticResource Ghost}" Margin="6,0,0,0"
                      Foreground="#2F4FC4" ToolTip="Gán giá trị cho mọi sheet của các schedule đang chọn">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE70F;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center"/>
                  <TextBlock Text="Gán" Margin="7,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
              </Button>
            </Grid>
            <TextBlock x:Name="fill_info" FontSize="12" Foreground="#8A8F98" Margin="2,6,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <Border x:Name="warn_box" CornerRadius="10" Background="#FFF8E6" Padding="12,10" Margin="0,10,0,0"
                Visibility="Collapsed">
          <StackPanel>
            <TextBlock x:Name="warn_text" Foreground="#8A5A00" FontSize="12" TextWrapping="Wrap"/>
            <CheckBox x:Name="force_chk" Margin="0,8,0,0" Foreground="#8A5A00" FontSize="12"
                      Content="Vẫn sửa các schedule này" Cursor="Hand"/>
          </StackPanel>
        </Border>
        <Border x:Name="done_box" CornerRadius="10" Background="#E8F7EF" Padding="12,10" Margin="0,10,0,0"
                Visibility="Collapsed">
          <TextBlock x:Name="done_text" Foreground="#16794C" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="open_btn" Style="{StaticResource Ghost}" ToolTip="Đóng cửa sổ và mở schedule đầu tiên đang chọn">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center"/>
              <TextBlock Text="Mở schedule" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="signers_btn" Grid.Column="1" Style="{StaticResource Ghost}" HorizontalAlignment="Left"
                  ToolTip="Ẩn / hiện cùng lúc Checked By, Approved By, Designed By, Drawn By trong các schedule đang chọn">
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="signers_icon" Text="&#xE7B3;" FontFamily="{StaticResource Icons}" FontSize="13"
                         VerticalAlignment="Center"/>
              <TextBlock x:Name="signers_text" Text="Hiện cột ký" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="apply_btn" Grid.Column="2" Style="{StaticResource Primary}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
              <TextBlock x:Name="apply_text" Text="Áp chuẩn" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</Window>
