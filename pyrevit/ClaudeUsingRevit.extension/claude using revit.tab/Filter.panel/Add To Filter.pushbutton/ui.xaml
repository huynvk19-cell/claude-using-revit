<!-- Liquid Glass: styles come from lib/liquid_glass.xaml (loaded by liquid_glass.GlassWindow) -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm vào filter" Width="540" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="{StaticResource Ui}" FontSize="13" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display">
  <ContentControl x:Name="glass" Style="{StaticResource GlassPanel}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid x:Name="header" Grid.Row="0" Margin="24,22,18,0" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ContentControl Style="{StaticResource AppIcon}" Content="&#xE71C;"/>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Thêm vào filter" Style="{StaticResource Title}"/>
          <TextBlock x:Name="summary" Style="{StaticResource Subtitle}" TextWrapping="Wrap"/>
        </StackPanel>
        <Button x:Name="close_btn" Grid.Column="2" Style="{StaticResource CloseBtn}" VerticalAlignment="Top"
                ToolTip="Đóng (Esc)"/>
      </Grid>

      <StackPanel Grid.Row="1" Margin="24,4,24,22">
        <TextBlock Text="LỌC THEO (CÙNG THAM SỐ LÀ HOẶC, KHÁC THAM SỐ LÀ VÀ)" Style="{StaticResource Caption}"/>
        <Border Style="{StaticResource Well}">
          <ScrollViewer MaxHeight="210" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="param_list"/>
          </ScrollViewer>
        </Border>

        <TextBlock Text="VIEW TEMPLATE" Style="{StaticResource Caption}" Margin="6,14,0,6"/>
        <ComboBox x:Name="target_box" Height="34" VerticalContentAlignment="Center"/>

        <TextBlock Text="FILTER" Style="{StaticResource Caption}" Margin="6,14,0,6"/>
        <ComboBox x:Name="filter_box" Height="34" VerticalContentAlignment="Center"
                  ToolTip="Filter có sẵn thì được mở rộng thêm các giá trị này"/>
        <TextBox x:Name="name_box" Height="34" Margin="0,6,0,0" VerticalContentAlignment="Center"
                 ToolTip="Tên filter mới"/>

        <Border Style="{StaticResource SegTrack}" Margin="0,14,0,0" HorizontalAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="hide_rb" GroupName="mode" Style="{StaticResource Seg}" Content="Hide"/>
            <RadioButton x:Name="show_rb" GroupName="mode" Style="{StaticResource Seg}" Content="No hide"/>
          </StackPanel>
        </Border>

        <Border x:Name="warn_box" Style="{StaticResource WarnNote}" Visibility="Collapsed">
          <TextBlock x:Name="warn_text" Foreground="#8A5A00" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="apply_btn" Grid.Column="1" Style="{StaticResource Primary}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE71C;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
              <TextBlock Text="Thêm" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>
    </Grid>
  </ContentControl>
</Window>
