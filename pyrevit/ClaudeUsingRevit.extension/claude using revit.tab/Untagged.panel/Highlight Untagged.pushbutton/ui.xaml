<!-- Liquid Glass: styles come from lib/liquid_glass.xaml (loaded by liquid_glass.GlassWindow);
     this tool overrides the accent with orange -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Untagged" Width="520" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="{StaticResource Ui}" FontSize="13" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FFA23A" Offset="0"/>
      <GradientStop Color="#FF5F2E" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="AccentColor">#FF6A1F</Color>
    <SolidColorBrush x:Key="AccentSoft" Color="#2EFF8A3D"/>
    <SolidColorBrush x:Key="AccentEdge" Color="#BFFF8A3D"/>
    <SolidColorBrush x:Key="AccentText" Color="#B4410F"/>
  </Window.Resources>

  <ContentControl x:Name="glass" Style="{StaticResource GlassPanel}">
    <Grid>
      <!-- header (shared) -->
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid x:Name="header" Grid.Row="0" Margin="24,22,18,0" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ContentControl Style="{StaticResource AppIcon}" Content="&#xE8EC;"/>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="head_title" Text="Đối tượng chưa tag" Style="{StaticResource Title}"/>
          <TextBlock x:Name="head_sub" Text="Tìm và tô cam những gì còn thiếu tag trong view"
                     Style="{StaticResource Subtitle}"/>
        </StackPanel>
        <Button x:Name="close_btn" Grid.Column="2" Style="{StaticResource CloseBtn}" VerticalAlignment="Top"
                ToolTip="Đóng (Esc)"/>
      </Grid>

      <!-- step 1: set up -->
      <StackPanel x:Name="setup_panel" Grid.Row="1" Margin="24,4,24,22">
        <TextBlock Text="PHẠM VI" Style="{StaticResource Caption}"/>
        <Border Style="{StaticResource SegTrack}">
          <UniformGrid Columns="4">
            <RadioButton x:Name="sc_sel" GroupName="scope" Style="{StaticResource Seg}" Content="Đang chọn"/>
            <RadioButton x:Name="sc_active" GroupName="scope" Style="{StaticResource Seg}" Content="View đang mở"/>
            <RadioButton x:Name="sc_sheets" GroupName="scope" Style="{StaticResource Seg}" Content="Chọn sheet…"/>
            <RadioButton x:Name="sc_views" GroupName="scope" Style="{StaticResource Seg}" Content="Chọn view…"/>
          </UniformGrid>
        </Border>
        <TextBlock x:Name="scope_info" Foreground="{StaticResource Ink2}" FontSize="12" Margin="8,8,0,0"
                   TextTrimming="CharacterEllipsis"/>

        <TextBlock Text="ĐỐI TƯỢNG CẦN KIỂM TRA" Style="{StaticResource Caption}"/>
        <WrapPanel x:Name="chips"/>

        <Border Style="{StaticResource Stat}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="big_count" Text="0" FontFamily="{StaticResource UiDisplay}" FontSize="34"
                       FontWeight="SemiBold" Foreground="#FF5A36" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="summary" FontWeight="SemiBold" Text="đối tượng chưa tag"/>
              <TextBlock x:Name="summary_sub" Foreground="{StaticResource Ink2}" FontSize="12" Margin="0,2,0,0"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="clear_btn" Style="{StaticResource Ghost}" ToolTip="Xoá các vùng tô cam do bạn tạo trong phạm vi này">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center"/>
              <TextBlock x:Name="clear_text" Text="Xoá vùng tô" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="apply_btn" Grid.Column="2" Style="{StaticResource Primary}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE771;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
              <TextBlock x:Name="apply_text" Text="Tô vùng" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>

      <!-- step 2: result -->
      <StackPanel x:Name="result_panel" Grid.Row="1" Margin="24,4,24,22" Visibility="Collapsed">
        <TextBlock Text="BẤM MỘT VIEW ĐỂ MỞ VÀ CHỌN SẴN CÁC ĐỐI TƯỢNG CHƯA TAG" Style="{StaticResource Caption}"/>
        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="result_list"/>
        </ScrollViewer>
        <Border x:Name="notes_box" Style="{StaticResource WarnNote}" Margin="0,8,0,0" Visibility="Collapsed">
          <TextBlock x:Name="notes" Foreground="#8A5A00" FontSize="12" TextWrapping="Wrap"/>
        </Border>
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="back_btn" Style="{StaticResource Ghost}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center"/>
              <TextBlock Text="Quay lại" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="done_btn" Grid.Column="2" Style="{StaticResource Primary}" Content="Xong"/>
        </Grid>
      </StackPanel>
    </Grid>
  </ContentControl>
</Window>
