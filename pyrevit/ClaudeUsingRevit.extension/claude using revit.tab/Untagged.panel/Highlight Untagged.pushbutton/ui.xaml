<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Untagged" Width="500" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Foreground="#1F2328"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FFA41C" Offset="0"/>
      <GradientStop Color="#FF5A36" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#8A8F98"/>
      <Setter Property="Margin" Value="2,18,0,8"/>
    </Style>

    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#6B7280"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="b" CornerRadius="8" Padding="6,8" Margin="2" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#E9E9EE"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#1F2328"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter TargetName="b" Property="Effect">
                  <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12"/>
                  </Setter.Value>
                </Setter>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Foreground" Value="#6B7280"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="b" CornerRadius="18" Padding="12,7,8,7"
                    Background="#F5F5F7" BorderBrush="#E6E6EB" BorderThickness="1">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#FFC59A"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="b" Property="Background" Value="#FFF3E8"/>
                <Setter TargetName="b" Property="BorderBrush" Value="#FF8A3D"/>
                <Setter Property="Foreground" Value="#B4410F"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="10" Padding="18,10" Background="{StaticResource Accent}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="b" Property="Background" Value="#D9D9DE"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Ghost" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#4B5563"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="10" Padding="12,10" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#F1F1F4"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Row" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="10" Padding="12,9" Margin="0,0,0,6"
                    Background="#F7F7F9" BorderBrush="#EDEDF1" BorderThickness="1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#FF8A3D"/>
                <Setter TargetName="b" Property="Background" Value="#FFF8F2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="18" CornerRadius="16" Background="White" BorderBrush="#E6E6EB" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.20"/>
    </Border.Effect>
    <Grid>
      <!-- header (shared) -->
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid x:Name="header" Grid.Row="0" Margin="22,20,14,0" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource Accent}">
          <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource Icons}" FontSize="19"
                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="head_title" Text="Đối tượng chưa tag" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock x:Name="head_sub" TextTrimming="CharacterEllipsis" Text="Tìm và tô cam những gì còn thiếu tag trong view"
                     Foreground="#8A8F98" Margin="0,2,0,0"/>
        </StackPanel>
        <Button x:Name="close_btn" Grid.Column="2" Style="{StaticResource Ghost}" VerticalAlignment="Top"
                ToolTip="Đóng (Esc)">
          <TextBlock Text="&#xE711;" FontFamily="{StaticResource Icons}" FontSize="12"/>
        </Button>
      </Grid>

      <!-- step 1: set up -->
      <StackPanel x:Name="setup_panel" Grid.Row="1" Margin="22,4,22,20">
        <TextBlock Text="PHẠM VI" Style="{StaticResource Caption}"/>
        <Border CornerRadius="10" Background="#F1F1F4" Padding="2">
          <UniformGrid Columns="4">
            <RadioButton x:Name="sc_sel" GroupName="scope" Style="{StaticResource Seg}" Content="Đang chọn"/>
            <RadioButton x:Name="sc_active" GroupName="scope" Style="{StaticResource Seg}" Content="View đang mở"/>
            <RadioButton x:Name="sc_sheets" GroupName="scope" Style="{StaticResource Seg}" Content="Chọn sheet…"/>
            <RadioButton x:Name="sc_views" GroupName="scope" Style="{StaticResource Seg}" Content="Chọn view…"/>
          </UniformGrid>
        </Border>
        <TextBlock x:Name="scope_info" Foreground="#8A8F98" FontSize="12" Margin="4,8,0,0"
                   TextTrimming="CharacterEllipsis"/>

        <TextBlock Text="ĐỐI TƯỢNG CẦN KIỂM TRA" Style="{StaticResource Caption}"/>
        <WrapPanel x:Name="chips"/>

        <Border CornerRadius="12" Background="#FAFAFB" BorderBrush="#EFEFF3" BorderThickness="1"
                Padding="14,12" Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="big_count" Text="0" FontSize="28" FontWeight="SemiBold"
                       Foreground="#FF5A36" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="summary" FontWeight="SemiBold" Text="đối tượng chưa tag"/>
              <TextBlock x:Name="summary_sub" Foreground="#8A8F98" FontSize="12" Margin="0,2,0,0"
                         TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="clear_btn" Style="{StaticResource Ghost}" ToolTip="Xoá các vùng tô cam do bạn tạo trong phạm vi này">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center"/>
              <TextBlock x:Name="clear_text" Text="Xoá vùng tô" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="apply_btn" Grid.Column="2" Style="{StaticResource Primary}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE771;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center"/>
              <TextBlock x:Name="apply_text" Text="Tô vùng" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>

      <!-- step 2: result -->
      <StackPanel x:Name="result_panel" Grid.Row="1" Margin="22,4,22,20" Visibility="Collapsed">
        <TextBlock Text="BẤM MỘT VIEW ĐỂ MỞ VÀ CHỌN SẴN CÁC ĐỐI TƯỢNG CHƯA TAG" Style="{StaticResource Caption}"/>
        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="result_list"/>
        </ScrollViewer>
        <Border x:Name="notes_box" CornerRadius="10" Background="#FFF8E6" Padding="12,10" Margin="0,8,0,0"
                Visibility="Collapsed">
          <TextBlock x:Name="notes" Foreground="#8A5A00" FontSize="12" TextWrapping="Wrap"/>
        </Border>
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="back_btn" Style="{StaticResource Ghost}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center"/>
              <TextBlock Text="Quay lại" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="done_btn" Grid.Column="2" Style="{StaticResource Primary}" Content="Xong"/>
        </Grid>
      </StackPanel>
    </Grid>
  </Border>
</Window>
