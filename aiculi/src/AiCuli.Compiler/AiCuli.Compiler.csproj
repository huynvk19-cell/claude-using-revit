<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The C# compiler (Roslyn) of the dynamic commands (revit-commands/*.cs), kept out of AiCuli.dll:
    AI Culi loads it from roslyn/ on first use, in its own AssemblyLoadContext on .NET 8+, so another
    add-in's Roslyn in the same Revit never clashes with it. API: Compiler.Compile (strings in, bytes out).
      net48  -> Revit 2023-2024      net8.0 -> Revit 2025+ (also runs on .NET 10)
  -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>AiCuli.Compiler</AssemblyName>
    <RootNamespace>AiCuli.Compiler</RootNamespace>
    <Version>0.1.0</Version>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
